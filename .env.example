# Supabase Configuration
# Obtenha essas credenciais em: https://supabase.com/ → Project Settings → API

# URL do projeto Supabase (pública)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave anônima do Supabase (pública — segura para o client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Chave service_role do Supabase (SECRETA — nunca exponha no client)
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# URL do site em produção (usada para redirects de email de confirmação/recuperação)
# Em desenvolvimento, o fallback é http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://seu-dominio.com.br

# Instruções:
# 1. Copie este arquivo e renomeie para .env.local
# 2. Substitua os valores pelos dados reais do seu projeto Supabase
# 3. NUNCA comite o arquivo .env.local no Git
# 4. As chaves estão no dashboard do Supabase: Project Settings → API
